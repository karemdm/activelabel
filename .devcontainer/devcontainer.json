// Opens ActiveLabel in GitHub Codespaces. Keep the port in "forwardPorts" and in
// "postStartCommand" equal (tests/test_devcontainer.py checks it).
{
  "name": "ActiveLabel",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "containerEnv": { "ACTIVELABEL_WORKSPACE": "/workspaces/activelabel-data" },
  "onCreateCommand": "mkdir -p /workspaces/activelabel-data && pip install -e .",
  "postStartCommand": "nohup python -m activelabel.cli serve --host 0.0.0.0 --port 8100 > /tmp/activelabel.log 2>&1 &",
  "forwardPorts": [8100],
  "portsAttributes": {
    "8100": { "label": "ActiveLabel", "onAutoForward": "openBrowser" }
  }
}
